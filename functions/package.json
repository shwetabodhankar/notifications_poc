{
  "name": "notification-rule-engine",
  "version": "1.0.0",
  "description": "Azure Function rule engine for enterprise notification routing",
  "main": "rule-engine/index.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "func start",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "lint": "eslint . --ext .js",
    "validate-rules": "node scripts/validate-rules.js"
  },
  "dependencies": {
    "@azure/identity": "^4.4.1",
    "@azure/storage-blob": "^12.24.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  },
  "devDependencies": {
    "@azure/functions": "^4.5.0",
    "eslint": "^9.9.0",
    "jest": "^29.7.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.js",
      "**/*.test.js"
    ],
    "collectCoverageFrom": [
      "rule-engine/**/*.js"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 85,
        "lines": 85
      }
    }
  }
}
