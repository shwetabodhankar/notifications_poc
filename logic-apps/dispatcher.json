{
  "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "teamsNotifierUrl": {
      "type": "securestring",
      "metadata": { "description": "HTTP trigger URL of the Teams Notifier Logic App" }
    },
    "emailNotifierUrl": {
      "type": "securestring",
      "metadata": { "description": "HTTP trigger URL of the Email Notifier Logic App" }
    }
  },
  "triggers": {
    "Receive_Dispatch_Request": {
      "type": "Request",
      "kind": "Http",
      "inputs": {
        "method": "POST",
        "schema": {
          "type": "object",
          "required": ["correlationId", "workItem", "routingResult"],
          "properties": {
            "correlationId": { "type": "string" },
            "workItem": { "type": "object" },
            "routingResult": {
              "type": "object",
              "properties": {
                "matchedRuleCount": { "type": "integer" },
                "routingDecisions": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "ruleId": { "type": "string" },
                      "ruleName": { "type": "string" },
                      "routing": { "type": "object" }
                    }
                  }
                },
                "scenarios": {
                  "type": "array",
                  "items": { "type": "string" }
                }
              }
            }
          }
        }
      }
    }
  },
  "actions": {
    "Initialize_DispatchResults": {
      "type": "InitializeVariable",
      "runAfter": {},
      "inputs": {
        "variables": [
          {
            "name": "dispatchResults",
            "type": "array",
            "value": []
          }
        ]
      }
    },
    "Check_Has_Routing_Decisions": {
      "type": "If",
      "runAfter": {
        "Initialize_DispatchResults": [ "Succeeded" ]
      },
      "expression": {
        "greater": [
          "@coalesce(triggerBody()?['routingResult']?['matchedRuleCount'], 0)",
          0
        ]
      },
      "actions": {
        "For_Each_Routing_Decision": {
          "type": "Foreach",
          "runAfter": {},
          "foreach": "@triggerBody()?['routingResult']?['routingDecisions']",
          "runtimeConfiguration": {
            "concurrency": {
              "repetitions": 1
            }
          },
          "actions": {
            "Dispatch_Teams_Notification": {
              "type": "If",
              "runAfter": {},
              "expression": {
                "and": [
                  {
                    "not": {
                      "equals": [
                        "@item()?['routing']?['teamsTeamId']",
                        null
                      ]
                    }
                  },
                  {
                    "not": {
                      "equals": [
                        "@item()?['routing']?['teamsTeamId']",
                        ""
                      ]
                    }
                  },
                  {
                    "not": {
                      "equals": [
                        "@item()?['routing']?['teamsChannelId']",
                        null
                      ]
                    }
                  },
                  {
                    "not": {
                      "equals": [
                        "@item()?['routing']?['teamsChannelId']",
                        ""
                      ]
                    }
                  }
                ]
              },
              "actions": {
                "Call_Teams_Notifier": {
                  "type": "Http",
                  "runAfter": {},
                  "inputs": {
                    "method": "POST",
                    "uri": "@parameters('teamsNotifierUrl')",
                    "headers": {
                      "Content-Type": "application/json",
                      "x-correlation-id": "@triggerBody()?['correlationId']"
                    },
                    "body": {
                      "correlationId": "@triggerBody()?['correlationId']",
                      "channelName": "@item()?['routing']?['teamsChannelName']",
                      "teamsTeamId": "@item()?['routing']?['teamsTeamId']",
                      "teamsChannelId": "@item()?['routing']?['teamsChannelId']",
                      "workItem": "@triggerBody()?['workItem']",
                      "ruleId": "@item()?['ruleId']",
                      "ruleName": "@item()?['ruleName']",
                      "scenarios": "@triggerBody()?['routingResult']?['scenarios']"
                    },
                    "retryPolicy": {
                      "type": "exponential",
                      "count": 3,
                      "interval": "PT5S",
                      "minimumInterval": "PT5S",
                      "maximumInterval": "PT30S"
                    }
                  }
                }
              },
              "else": {
                "actions": {}
              }
            },
            "Dispatch_Email_Notification": {
              "type": "If",
              "runAfter": {
                "Dispatch_Teams_Notification": [ "Succeeded", "Skipped" ]
              },
              "expression": {
                "and": [
                  {
                    "not": {
                      "equals": [
                        "@item()?['routing']?['emailGroup']",
                        null
                      ]
                    }
                  },
                  {
                    "not": {
                      "equals": [
                        "@item()?['routing']?['emailGroup']",
                        ""
                      ]
                    }
                  }
                ]
              },
              "actions": {
                "Call_Email_Notifier_Primary": {
                  "type": "Http",
                  "runAfter": {},
                  "inputs": {
                    "method": "POST",
                    "uri": "@parameters('emailNotifierUrl')",
                    "headers": {
                      "Content-Type": "application/json",
                      "x-correlation-id": "@triggerBody()?['correlationId']"
                    },
                    "body": {
                      "correlationId": "@triggerBody()?['correlationId']",
                      "emailTo": "@item()?['routing']?['emailGroup']",
                      "emailType": "primary",
                      "workItem": "@triggerBody()?['workItem']",
                      "ruleId": "@item()?['ruleId']",
                      "ruleName": "@item()?['ruleName']",
                      "scenarios": "@triggerBody()?['routingResult']?['scenarios']"
                    },
                    "retryPolicy": {
                      "type": "exponential",
                      "count": 3,
                      "interval": "PT5S",
                      "minimumInterval": "PT5S",
                      "maximumInterval": "PT30S"
                    }
                  }
                }
              },
              "else": {
                "actions": {}
              }
            },
            "Dispatch_Escalation_Email": {
              "type": "If",
              "runAfter": {
                "Dispatch_Email_Notification": [ "Succeeded", "Skipped" ]
              },
              "expression": {
                "and": [
                  {
                    "not": {
                      "equals": [
                        "@item()?['routing']?['escalationGroup']",
                        null
                      ]
                    }
                  },
                  {
                    "contains": [
                      "@triggerBody()?['routingResult']?['scenarios']",
                      "B"
                    ]
                  }
                ]
              },
              "actions": {
                "Call_Email_Notifier_Escalation": {
                  "type": "Http",
                  "runAfter": {},
                  "inputs": {
                    "method": "POST",
                    "uri": "@parameters('emailNotifierUrl')",
                    "headers": {
                      "Content-Type": "application/json",
                      "x-correlation-id": "@triggerBody()?['correlationId']"
                    },
                    "body": {
                      "correlationId": "@triggerBody()?['correlationId']",
                      "emailTo": "@item()?['routing']?['escalationGroup']",
                      "emailType": "escalation",
                      "workItem": "@triggerBody()?['workItem']",
                      "ruleId": "@item()?['ruleId']",
                      "ruleName": "@item()?['ruleName']",
                      "scenarios": "@triggerBody()?['routingResult']?['scenarios']"
                    },
                    "retryPolicy": {
                      "type": "exponential",
                      "count": 3,
                      "interval": "PT5S",
                      "minimumInterval": "PT5S",
                      "maximumInterval": "PT30S"
                    }
                  }
                }
              },
              "else": {
                "actions": {}
              }
            },
            "Dispatch_Security_Liaison_Email": {
              "type": "If",
              "runAfter": {
                "Dispatch_Escalation_Email": [ "Succeeded", "Skipped" ]
              },
              "expression": {
                "and": [
                  {
                    "not": {
                      "equals": [
                        "@item()?['routing']?['securityLiaison']",
                        null
                      ]
                    }
                  },
                  {
                    "contains": [
                      "@triggerBody()?['routingResult']?['scenarios']",
                      "C"
                    ]
                  }
                ]
              },
              "actions": {
                "Call_Email_Notifier_Security": {
                  "type": "Http",
                  "runAfter": {},
                  "inputs": {
                    "method": "POST",
                    "uri": "@parameters('emailNotifierUrl')",
                    "headers": {
                      "Content-Type": "application/json",
                      "x-correlation-id": "@triggerBody()?['correlationId']"
                    },
                    "body": {
                      "correlationId": "@triggerBody()?['correlationId']",
                      "emailTo": "@item()?['routing']?['securityLiaison']",
                      "emailType": "security-liaison",
                      "workItem": "@triggerBody()?['workItem']",
                      "ruleId": "@item()?['ruleId']",
                      "ruleName": "@item()?['ruleName']",
                      "scenarios": "@triggerBody()?['routingResult']?['scenarios']"
                    },
                    "retryPolicy": {
                      "type": "exponential",
                      "count": 3,
                      "interval": "PT5S",
                      "minimumInterval": "PT5S",
                      "maximumInterval": "PT30S"
                    }
                  }
                }
              },
              "else": {
                "actions": {}
              }
            }
          }
        }
      },
      "else": {
        "actions": {
          "Log_No_Rules_Matched": {
            "type": "Compose",
            "runAfter": {},
            "inputs": {
              "correlationId": "@triggerBody()?['correlationId']",
              "message": "No routing rules matched for this work item — no notifications sent",
              "workItemId": "@triggerBody()?['workItem']?['workItemId']"
            }
          }
        }
      }
    },
    "Return_Dispatch_Response": {
      "type": "Response",
      "kind": "Http",
      "runAfter": {
        "Check_Has_Routing_Decisions": [ "Succeeded", "Failed", "Skipped" ]
      },
      "inputs": {
        "statusCode": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "correlationId": "@triggerBody()?['correlationId']",
          "status": "dispatched",
          "matchedRuleCount": "@triggerBody()?['routingResult']?['matchedRuleCount']",
          "scenarios": "@triggerBody()?['routingResult']?['scenarios']",
          "timestamp": "@utcNow()"
        }
      }
    }
  },
  "outputs": {}
}
