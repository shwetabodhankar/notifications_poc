{
  "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {},
  "triggers": {
    "Receive_Teams_Notification_Request": {
      "type": "Request",
      "kind": "Http",
      "inputs": {
        "method": "POST",
        "schema": {
          "type": "object",
          "required": ["correlationId", "channelWebhookUrl", "workItem"],
          "properties": {
            "correlationId": { "type": "string" },
            "channelWebhookUrl": { "type": "string" },
            "channelName": { "type": "string" },
            "ruleId": { "type": "string" },
            "ruleName": { "type": "string" },
            "scenarios": {
              "type": "array",
              "items": { "type": "string" }
            },
            "workItem": {
              "type": "object",
              "properties": {
                "workItemId": {},
                "workItemUrl": { "type": "string" },
                "title": { "type": "string" },
                "state": { "type": "string" },
                "workItemType": { "type": "string" },
                "teamProject": { "type": "string" },
                "areaPath": { "type": "string" },
                "assignedTo": { "type": "string" },
                "priority": { "type": "string" },
                "product": { "type": "string" },
                "productFamily": { "type": "string" },
                "isCyberSecurity": {},
                "isHotfix": {},
                "eventType": { "type": "string" }
              }
            }
          }
        }
      }
    }
  },
  "actions": {
    "Determine_Event_Action": {
      "type": "Compose",
      "runAfter": {},
      "inputs": "@if(equals(triggerBody()?['workItem']?['eventType'], 'workitem.created'), 'Created', 'Updated')"
    },
    "Determine_Priority_Color": {
      "type": "Compose",
      "runAfter": {
        "Determine_Event_Action": [ "Succeeded" ]
      },
      "inputs": "@if(equals(triggerBody()?['workItem']?['priority'], '1'), 'attention', if(equals(triggerBody()?['workItem']?['priority'], '2'), 'warning', 'good'))"
    },
    "Determine_Scenario_Label": {
      "type": "Compose",
      "runAfter": {
        "Determine_Priority_Color": [ "Succeeded" ]
      },
      "inputs": "@concat(if(contains(coalesce(triggerBody()?['scenarios'], json('[]')), 'C'), '🔒 CYBER SECURITY | ', ''), if(contains(coalesce(triggerBody()?['scenarios'], json('[]')), 'B'), '🚨 P1 CRITICAL | ', ''), 'Scenario A')"
    },
    "Compose_Adaptive_Card": {
      "type": "Compose",
      "runAfter": {
        "Determine_Scenario_Label": [ "Succeeded" ]
      },
      "inputs": {
        "type": "message",
        "attachments": [
          {
            "contentType": "application/vnd.microsoft.card.adaptive",
            "content": {
              "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
              "type": "AdaptiveCard",
              "version": "1.5",
              "body": [
                {
                  "type": "Container",
                  "style": "@outputs('Determine_Priority_Color')",
                  "items": [
                    {
                      "type": "ColumnSet",
                      "columns": [
                        {
                          "type": "Column",
                          "width": "stretch",
                          "items": [
                            {
                              "type": "TextBlock",
                              "text": "@{concat('Work Item ', outputs('Determine_Event_Action'), ' — ', triggerBody()?['workItem']?['product'])}",
                              "weight": "Bolder",
                              "size": "Medium",
                              "wrap": true
                            },
                            {
                              "type": "TextBlock",
                              "text": "@outputs('Determine_Scenario_Label')",
                              "size": "Small",
                              "isSubtle": true
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "FactSet",
                  "facts": [
                    {
                      "title": "Work Item",
                      "value": "@{concat('#', triggerBody()?['workItem']?['workItemId'], ' — ', triggerBody()?['workItem']?['title'])}"
                    },
                    {
                      "title": "Type",
                      "value": "@triggerBody()?['workItem']?['workItemType']"
                    },
                    {
                      "title": "Priority",
                      "value": "@{concat('P', triggerBody()?['workItem']?['priority'])}"
                    },
                    {
                      "title": "State",
                      "value": "@triggerBody()?['workItem']?['state']"
                    },
                    {
                      "title": "Product",
                      "value": "@{concat(triggerBody()?['workItem']?['product'], if(empty(triggerBody()?['workItem']?['productFamily']), '', concat(' / ', triggerBody()?['workItem']?['productFamily'])))}"
                    },
                    {
                      "title": "Area Path",
                      "value": "@triggerBody()?['workItem']?['areaPath']"
                    },
                    {
                      "title": "Assigned To",
                      "value": "@coalesce(triggerBody()?['workItem']?['assignedTo'], 'Unassigned')"
                    },
                    {
                      "title": "Project",
                      "value": "@triggerBody()?['workItem']?['teamProject']"
                    },
                    {
                      "title": "Routing Rule",
                      "value": "@{concat('[', triggerBody()?['ruleId'], '] ', triggerBody()?['ruleName'])}"
                    },
                    {
                      "title": "Correlation ID",
                      "value": "@triggerBody()?['correlationId']"
                    }
                  ]
                },
                {
                  "type": "ActionSet",
                  "actions": [
                    {
                      "type": "Action.OpenUrl",
                      "title": "Open in Azure DevOps",
                      "url": "@triggerBody()?['workItem']?['workItemUrl']"
                    }
                  ]
                }
              ]
            }
          }
        ]
      }
    },
    "Post_To_Teams_Channel": {
      "type": "Http",
      "runAfter": {
        "Compose_Adaptive_Card": [ "Succeeded" ]
      },
      "inputs": {
        "method": "POST",
        "uri": "@triggerBody()?['channelWebhookUrl']",
        "headers": {
          "Content-Type": "application/json"
        },
        "body": "@outputs('Compose_Adaptive_Card')",
        "retryPolicy": {
          "type": "exponential",
          "count": 3,
          "interval": "PT5S",
          "minimumInterval": "PT5S",
          "maximumInterval": "PT30S"
        }
      }
    },
    "Return_Teams_Response": {
      "type": "Response",
      "kind": "Http",
      "runAfter": {
        "Post_To_Teams_Channel": [ "Succeeded", "Failed" ]
      },
      "inputs": {
        "statusCode": "@if(equals(outputs('Post_To_Teams_Channel')?['statusCode'], 200), 200, 502)",
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "correlationId": "@triggerBody()?['correlationId']",
          "channel": "Teams",
          "channelName": "@triggerBody()?['channelName']",
          "status": "@if(equals(outputs('Post_To_Teams_Channel')?['statusCode'], 200), 'sent', 'failed')",
          "teamsStatusCode": "@outputs('Post_To_Teams_Channel')?['statusCode']",
          "timestamp": "@utcNow()"
        }
      }
    }
  },
  "outputs": {}
}
